<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SMICC SO DOPE | SMICCOPHISTO</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300;500;800&family=Oswald:wght@400;700&display=swap" rel="stylesheet">

    <style>
        /* CSS Reset & Variables */
        :root {
            --bg-color: #050505;
            --text-main: #f4f4f4;
            --text-muted: #888;
            --accent-red: rgba(166, 38, 38, 0.8);
            --accent-green: rgba(43, 89, 54, 0.8);
            --pure-red: #d32f2f;
            --pure-green: #388e3c;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            overscroll-behavior: none;
            cursor: default;
        }

        h1, h2, h3, .hype-font {
            font-family: 'Anton', sans-serif;
            text-transform: uppercase;
        }

        /* Ambient Background Glows */
        .ambient-glow {
            position: fixed;
            width: 50vw;
            height: 50vw;
            border-radius: 50%;
            filter: blur(150px);
            z-index: 0;
            opacity: 0.4;
            pointer-events: none;
        }
        .glow-red { top: -10%; left: -10%; background: var(--accent-red); }
        .glow-green { bottom: -10%; right: -10%; background: var(--accent-green); }

        /* Loader */
        .loader {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: #000;
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text-main);
        }
        .loader h1 {
            font-size: 5vw;
            letter-spacing: 0.5rem;
            overflow: hidden;
        }

        /* 3D Vintage Microphone */
        .mic-wrapper {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 300px;
            height: 500px;
            z-index: 10;
            perspective: 1200px;
            pointer-events: none;
        }

        .mic-3d-container {
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            position: relative;
        }

        .mic-layer {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            transform-style: preserve-3d;
        }

        /* SVG Vintage Mic Construction */
        .mic-layer svg {
            width: 100%; height: 100%;
            filter: drop-shadow(0px 20px 30px rgba(0,0,0,0.8));
        }
        
        .mic-back { transform: translateZ(-30px) scale(0.95); opacity: 0.7; filter: brightness(0.3); }
        .mic-mid { transform: translateZ(0px); }
        .mic-front { transform: translateZ(40px); filter: drop-shadow(0px 10px 10px rgba(0,0,0,0.9)); }
        .mic-stand { transform: translateZ(-10px); }

        /* Sections */
        section {
            position: relative;
            z-index: 2;
            width: 100vw;
            min-height: 100vh;
            padding: 5vw;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* Hero */
        .hero {
            height: 150vh; /* Extra height for scroll effect */
            align-items: center;
            text-align: center;
        }

        .hero-title-container {
            position: relative;
            z-index: 15;
            mix-blend-mode: difference;
        }

        .hero h1 {
            font-size: 14vw;
            line-height: 0.85;
            margin: 0;
            color: #fff;
            white-space: nowrap;
        }

        .hero-sub {
            font-family: 'Oswald', sans-serif;
            font-size: 2vw;
            letter-spacing: 0.3em;
            color: var(--pure-red);
            margin-top: 20px;
            font-weight: 700;
        }

        /* Overlapping Elements Layout */
        .overlap-grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 20px;
            width: 100%;
            position: relative;
        }

        /* About / Intro */
        .intro-text {
            grid-column: 2 / 10;
            font-size: 4vw;
            font-weight: 800;
            line-height: 1.1;
            text-transform: uppercase;
            color: transparent;
            -webkit-text-stroke: 1px var(--text-main);
            position: relative;
            z-index: 5;
        }
        .intro-text span {
            color: var(--text-main);
            -webkit-text-stroke: 0;
        }

        /* HGHLNDS 4114 Section */
        .hghlnds-section {
            background: linear-gradient(to bottom, transparent, rgba(43, 89, 54, 0.1), transparent);
        }
        
        .hghlnds-title {
            grid-column: 1 / 13;
            font-size: 10vw;
            color: var(--pure-green);
            opacity: 0.8;
            z-index: 1;
        }

        .hghlnds-card {
            background: #111;
            padding: 40px;
            border: 1px solid rgba(255,255,255,0.1);
            position: relative;
            z-index: 10;
        }
        
        .card-1 { grid-column: 2 / 6; margin-top: -10vw; border-left: 4px solid var(--pure-green); }
        .card-2 { grid-column: 7 / 12; margin-top: 5vw; border-right: 4px solid var(--pure-red); }

        .hghlnds-card h3 { font-size: 2.5rem; margin-bottom: 1rem; }
        .hghlnds-card p { font-size: 1rem; color: var(--text-muted); line-height: 1.6; font-family: 'Oswald', sans-serif;}

        /* Discography (Solos & Collabs) */
        .discography {
            min-height: 80vh;
        }
        .disco-tracklist {
            grid-column: 4 / 12;
            list-style: none;
            position: relative;
            z-index: 20;
        }
        .disco-tracklist li {
            font-family: 'Anton', sans-serif;
            font-size: 6vw;
            line-height: 1;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 2vw 0;
            cursor: pointer;
            transition: color 0.3s;
            position: relative;
            overflow: hidden;
        }
        .disco-tracklist li:hover {
            color: var(--pure-red);
            padding-left: 2vw;
        }
        .disco-tracklist li span {
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            font-weight: 300;
            color: var(--text-muted);
            display: block;
            text-transform: none;
            margin-top: 0.5rem;
        }

        /* Rap Battles Section */
        .battles-section {
            background: #000;
            position: relative;
            overflow: hidden;
        }
        .battles-bg-text {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            font-size: 25vw;
            color: rgba(211, 47, 47, 0.05);
            white-space: nowrap;
            pointer-events: none;
        }
        .battle-content {
            grid-column: 3 / 11;
            text-align: center;
            z-index: 5;
        }
        .battle-content h2 {
            font-size: 8vw;
            color: var(--pure-red);
            text-shadow: 0 0 20px rgba(211,47,47,0.5);
        }
        .battle-content p {
            font-size: 1.5rem;
            margin-top: 2rem;
            font-family: 'Oswald', sans-serif;
        }

        /* Footer */
        footer {
            padding: 5vw;
            text-align: center;
            border-top: 1px solid rgba(255,255,255,0.05);
        }
        footer h1 {
            font-size: 4vw;
            color: var(--text-muted);
        }

        /* Utilities */
        .line-clip { overflow: hidden; }
        .will-change { will-change: transform, opacity; }
    </style>
</head>
<body>

    <!-- Loading Screen -->
    <div class="loader">
        <h1 class="hype-font line-clip"><div class="loader-text">DROPPING BARS...</div></h1>
    </div>

    <!-- Ambient Glowing Orbs -->
    <div class="ambient-glow glow-red"></div>
    <div class="ambient-glow glow-green"></div>

    <!-- 3D Vintage Microphone (Fixed Position, responds to mouse/scroll) -->
    <div class="mic-wrapper">
        <div class="mic-3d-container">
            <!-- Back Layer (Depth) -->
            <div class="mic-layer mic-back">
                <svg viewBox="0 0 200 400" xmlns="http://www.w3.org/2000/svg">
                    <rect x="50" y="50" width="100" height="150" rx="40" fill="#222" />
                </svg>
            </div>
            <!-- Middle Layer (Base & Stand) -->
            <div class="mic-layer mic-stand">
                <svg viewBox="0 0 200 400" xmlns="http://www.w3.org/2000/svg">
                    <!-- Stand -->
                    <rect x="90" y="210" width="20" height="150" fill="url(#metalGrad)" />
                    <!-- Base Joint -->
                    <circle cx="100" cy="210" r="15" fill="#444" />
                    <!-- Stand Base -->
                    <path d="M 50 360 L 150 360 L 170 390 L 30 390 Z" fill="#111" />
                    <!-- Gradients -->
                    <defs>
                        <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#333" />
                            <stop offset="50%" stop-color="#888" />
                            <stop offset="100%" stop-color="#222" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <!-- Front Layer (Vintage Grille) -->
            <div class="mic-layer mic-front">
                <svg viewBox="0 0 200 400" xmlns="http://www.w3.org/2000/svg">
                    <!-- Outer Casing -->
                    <rect x="40" y="40" width="120" height="170" rx="50" fill="none" stroke="url(#metalGrad)" stroke-width="12" />
                    <!-- Horizontal Grille Lines -->
                    <line x1="45" y1="80" x2="155" y2="80" stroke="url(#metalGrad)" stroke-width="6" />
                    <line x1="42" y1="105" x2="158" y2="105" stroke="url(#metalGrad)" stroke-width="6" />
                    <line x1="40" y1="130" x2="160" y2="130" stroke="url(#metalGrad)" stroke-width="8" />
                    <line x1="42" y1="155" x2="158" y2="155" stroke="url(#metalGrad)" stroke-width="6" />
                    <line x1="45" y1="180" x2="155" y2="180" stroke="url(#metalGrad)" stroke-width="6" />
                    <!-- Vertical Center Bone -->
                    <line x1="100" y1="40" x2="100" y2="210" stroke="url(#metalGrad)" stroke-width="10" />
                    <!-- Red Inner Glow (Subtle accent) -->
                    <rect x="60" y="60" width="80" height="130" rx="30" fill="none" stroke="#d32f2f" stroke-width="2" opacity="0.6" filter="blur(4px)" />
                </svg>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    
    <!-- Section 1: Hero -->
    <section class="hero">
        <div class="hero-title-container">
            <h1 class="hero-main-text">SMICC SO DOPE</h1>
            <h1 class="hero-main-text">SMICCOPHISTO</h1>
            <div class="hero-sub">THE PHILIPPINE HIP-HOP SCENE'S ILLEST KEPT SECRET</div>
        </div>
    </section>

    <!-- Section 2: Intro / Bio -->
    <section class="about">
        <div class="overlap-grid">
            <div class="intro-text will-change">
                Emerging from the trenches of the underground, <span>Smicc So Dope</span> (AKA Smiccophisto) isn't just riding the beat. <span>He dissects it.</span> Unapologetic lyricism meets highland grit.
            </div>
        </div>
    </section>

    <!-- Section 3: HGHLNDS 4114 -->
    <section class="hghlnds-section">
        <div class="overlap-grid">
            <h2 class="hghlnds-title hype-font will-change">HGHLNDS 4114</h2>
            
            <div class="hghlnds-card card-1 will-change">
                <h3 class="hype-font">THE SYNDICATE</h3>
                <p>Frontlining HGHLNDS 4114, Smiccophisto and the crew are elevating the culture from the highlands to the world stage. We don't just drop tracks; we engineer anthems that echo through the concrete jungle.</p>
            </div>

            <div class="hghlnds-card card-2 will-change">
                <h3 class="hype-font">RAW & UNFILTERED</h3>
                <p>Collaborations that shift the paradigm. The HGHLNDS 4114 movement represents a new era of Philippine hip-hop. Authentic storytelling fueled by aggressive beats and surgical wordplay.</p>
            </div>
        </div>
    </section>

    <!-- Section 4: Discography (Solos & Collabs) -->
    <section class="discography">
        <div class="overlap-grid">
            <ul class="disco-tracklist">
                <li class="track will-change">THE ARSENAL <span>Solos, Singles & Raw Cuts</span></li>
                <li class="track will-change">BLOOD & EMERALDS <span>Prod. by HGHLNDS 4114</span></li>
                <li class="track will-change">HIGHLAND ECHOES <span>Smiccophisto Solo</span></li>
                <li class="track will-change">BARS OF THE ORIENT <span>Heavyweight Collab</span></li>
                <li class="track will-change">STREET CADENCE <span>Smicc So Dope x HGHLNDS</span></li>
            </ul>
        </div>
    </section>

    <!-- Section 5: Rap Battles -->
    <section class="battles-section">
        <div class="battles-bg-text hype-font">LYRICAL DECAPITATION</div>
        <div class="overlap-grid">
            <div class="battle-content will-change">
                <h2>BATTLE TESTED.<br>CROWNED IN THE ARENA.</h2>
                <p>A brutal force in the rap battle circuit. Armed with complex schemes, aggressive delivery, and surgical precision, Smiccophisto steps into the pit not to compete, but to end careers. Every battle is a masterclass in verbal warfare.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <h1 class="hype-font">SMICC SO DOPE &copy; 2026</h1>
        <p style="color: var(--text-muted); font-family: 'Oswald', sans-serif; margin-top: 10px;">REPRESENTING HGHLNDS 4114</p>
    </footer>

    <!-- Scripts: GSAP, ScrollTrigger, SplitType -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="https://unpkg.com/split-type"></script>

    <script>
        // Register GSAP Plugin
        gsap.registerPlugin(ScrollTrigger);

        // Wait for DOM
        document.addEventListener("DOMContentLoaded", () => {
            
            // --- LOADER ANIMATION ---
            const tlLoader = gsap.timeline();
            tlLoader.from(".loader-text", { y: 100, duration: 1, ease: "power4.out" })
                    .to(".loader-text", { y: -100, opacity: 0, duration: 0.8, ease: "power4.in", delay: 0.5 })
                    .to(".loader", { height: 0, duration: 1, ease: "expo.inOut" }, "-=0.2")
                    .from(".hero-main-text", { y: 150, opacity: 0, stagger: 0.1, duration: 1.5, ease: "power4.out", clipPath: "polygon(0 0, 100% 0, 100% 0%, 0% 0%)" }, "-=0.5")
                    .from(".hero-sub", { opacity: 0, y: 20, duration: 1 }, "-=1")
                    .from(".mic-wrapper", { scale: 0, rotationY: 180, duration: 2, ease: "elastic.out(1, 0.5)" }, "-=1.5");

            // --- 3D MICROPHONE MOUSE PARALLAX ---
            const micContainer = document.querySelector(".mic-3d-container");
            window.addEventListener("mousemove", (e) => {
                const xAxis = (window.innerWidth / 2 - e.pageX) / 25;
                const yAxis = (window.innerHeight / 2 - e.pageY) / 25;
                
                gsap.to(micContainer, {
                    rotationY: -xAxis,
                    rotationX: yAxis,
                    duration: 0.5,
                    ease: "power1.out"
                });
            });

            // --- SCROLL ANIMATIONS (Aggressive Overlaps) ---

            // Mic Rotation on Scroll
            gsap.to(micContainer, {
                rotationZ: 15,
                y: 200, // moves down aggressively
                ease: "none",
                scrollTrigger: {
                    trigger: "body",
                    start: "top top",
                    end: "bottom bottom",
                    scrub: 1
                }
            });

            // Hero Text fades out quickly
            gsap.to(".hero-title-container", {
                y: -300,
                opacity: 0,
                scrollTrigger: {
                    trigger: ".hero",
                    start: "top top",
                    end: "bottom top",
                    scrub: true
                }
            });

            // Intro Text Reveal
            const introSplit = new SplitType('.intro-text', { types: 'words' });
            gsap.from(introSplit.words, {
                opacity: 0,
                y: 50,
                rotationX: -90,
                stagger: 0.05,
                ease: "back.out(1.7)",
                scrollTrigger: {
                    trigger: ".about",
                    start: "top 70%",
                    end: "center 50%",
                    scrub: 1
                }
            });

            // HGHLNDS 4114 Section
            const tlHghlnds = gsap.timeline({
                scrollTrigger: {
                    trigger: ".hghlnds-section",
                    start: "top 80%",
                    end: "bottom 60%",
                    scrub: 1
                }
            });

            tlHghlnds.from(".hghlnds-title", { x: "-50vw", opacity: 0, ease: "power4.out" })
                     .from(".card-1", { y: 200, opacity: 0, rotation: -10, ease: "power3.out" }, "-=0.2")
                     .from(".card-2", { y: 300, opacity: 0, rotation: 10, ease: "power3.out" }, "-=0.4");

            // Discography Parallax List
            gsap.utils.toArray('.track').forEach((track, i) => {
                gsap.from(track, {
                    x: i % 2 === 0 ? -100 : 100,
                    opacity: 0,
                    ease: "expo.out",
                    scrollTrigger: {
                        trigger: track,
                        start: "top 90%",
                        end: "top 60%",
                        scrub: 1
                    }
                });
            });

            // Rap Battles Aggressive Reveal
            const tlBattles = gsap.timeline({
                scrollTrigger: {
                    trigger: ".battles-section",
                    start: "top 70%",
                    end: "center 50%",
                    scrub: 1
                }
            });

            tlBattles.from(".battles-bg-text", { scale: 0.5, opacity: 0, x: "20vw", ease: "power2.out" })
                     .from(".battle-content h2", { y: 100, opacity: 0, clipPath: "inset(100% 0 0 0)" }, "-=0.5")
                     .from(".battle-content p", { scale: 0.8, opacity: 0 }, "-=0.3");

            // Ambient Glow Movement based on scroll
            gsap.to(".glow-red", {
                y: "50vh", x: "20vw",
                scrollTrigger: { trigger: "body", start: "top top", end: "bottom bottom", scrub: 2 }
            });
            gsap.to(".glow-green", {
                y: "-50vh", x: "-20vw",
                scrollTrigger: { trigger: "body", start: "top top", end: "bottom bottom", scrub: 2 }
            });
        });
    </script>
</body>
</html>
